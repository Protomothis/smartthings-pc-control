                "name": "mode"
              }
            },
            {
              "name": "minutes",
              "label": "{{i18n.commands.execute.arguments.minutes.label}}",
              "displayType": "numberField",
              "numberField": {
                "range": [
                  0,
                  1440
                ],
                "unit": "min",
                "name": "minutes"
              }
