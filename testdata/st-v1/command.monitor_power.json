{
  "_doc": "Turn the primary monitor off (VCP 0xD6 = 4, DPM off) (#144). value on|off. Some monitors stop listening to DDC/CI once off: monitor_power on then fails with 502 monitor_failed and a message.",
  "method": "POST",
  "path": "/st/v1/command",
  "request": {
    "command": "monitor_power",
    "value": "off"
  },
  "response": {
    "body": {
      "accepted": true,
      "executed": true,
      "monitor": {
        "brightness": 40,
        "ddc": true,
        "id": "m1",
        "input": "hdmi1",
        "inputs": [
          "dp1",
          "hdmi1",
          "hdmi2"
        ],
        "name": "DELL U2720Q",
        "power": "standby",
        "primary": true
      },
      "schedule": {
        "active": false
      }
    },
    "code": 200
  }
}
