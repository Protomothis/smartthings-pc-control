{
  "_doc": "Switch the primary monitor's input (#144). value is a string: an MCCS name (vga1 dvi1 dp1 dp2 hdmi1 hdmi2 ...) or vcp:0xNN; status monitors[].inputs lists what the monitor offers.",
  "method": "POST",
  "path": "/st/v1/command",
  "request": {
    "command": "monitor_input",
    "value": "dp1"
  },
  "response": {
    "body": {
      "accepted": true,
      "executed": true,
      "monitor": {
        "brightness": 40,
        "ddc": true,
        "id": "m1",
        "input": "dp1",
        "inputs": [
          "dp1",
          "hdmi1",
          "hdmi2"
        ],
        "name": "DELL U2720Q",
        "power": "on",
        "primary": true
      },
      "schedule": {
        "active": false
      }
    },
    "code": 200
  }
}
